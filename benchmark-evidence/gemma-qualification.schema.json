{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fucina.dev/schemas/gemma-qualification-v1.json",
  "title": "Fucina Gemma qualification archive v1",
  "type": "object",
  "required": ["schema_version", "kind", "created_at"],
  "properties": {
    "schema_version": {"const": "fucina.gemma-qualification.v1"},
    "kind": {
      "enum": [
        "gemma-qualification-archive",
        "gemma-batch-mtp-probe",
        "gemma-oracle-comparison"
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string"},
    "config": {"type": "string"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "host": {"type": "object"},
    "subjects": {
      "type": "array",
      "items": {"$ref": "#/$defs/subject"}
    },
    "batch": {"type": "integer", "minimum": 2},
    "max_tokens": {"type": "integer", "minimum": 32},
    "mtp": {"type": "object"},
    "plain": {"type": "object"},
    "gate": {"type": "object"},
    "logits": {"type": "object"},
    "greedy_32": {"type": "object"},
    "passed": {"type": "boolean"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "gemma-qualification-archive"}}},
      "then": {"required": ["run_id", "config_sha256", "source", "host", "subjects"]}
    },
    {
      "if": {"properties": {"kind": {"const": "gemma-batch-mtp-probe"}}},
      "then": {"required": ["batch", "max_tokens", "mtp", "plain", "gate"]}
    },
    {
      "if": {"properties": {"kind": {"const": "gemma-oracle-comparison"}}},
      "then": {"required": ["logits", "greedy_32", "passed", "reference_sha256", "candidate_sha256"]}
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fingerprint": {
      "type": "object",
      "required": ["algorithm", "value", "source"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"$ref": "#/$defs/sha256"},
        "source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "distribution": {
      "type": "object",
      "required": ["count", "p50", "p95", "p99", "raw"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "p50": {"type": ["number", "null"]},
        "p95": {"type": ["number", "null"]},
        "p99": {"type": ["number", "null"]},
        "raw": {"type": "array", "items": {"type": "number"}}
      },
      "additionalProperties": false
    },
    "accounting": {
      "type": "object",
      "required": ["prompt_tokens", "cached_tokens", "new_prefill_tokens", "completion_tokens", "total_tokens"],
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0},
        "new_prefill_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["ttft_s", "itl_s", "event_offsets_s", "wall_s", "token_trace", "usage"],
      "properties": {
        "ttft_s": {"type": ["number", "null"]},
        "itl_s": {"type": "array", "items": {"type": "number"}},
        "event_offsets_s": {"type": "array", "items": {"type": "number"}},
        "wall_s": {"type": "number"},
        "per_stream_decode_tok_s": {"type": ["number", "null"]},
        "token_trace": {"type": "array", "items": {"type": "string"}},
        "token_ids": {"type": "array", "items": {"type": "integer"}},
        "text": {"type": "string"},
        "usage": {"$ref": "#/$defs/accounting"}
      },
      "additionalProperties": true
    },
    "start": {
      "type": "object",
      "required": ["index", "startup_to_ready_s", "memory", "cold_warm", "throughput", "server_log"],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "startup_to_ready_s": {"type": "number", "minimum": 0},
        "memory": {
          "type": "object",
          "required": ["peak_rss_mib", "peak_hwm_mib", "peak_gpu_mib", "samples"]
        },
        "cold_warm": {"type": "object"},
        "throughput": {"type": "array"},
        "server_log": {"type": "string"}
      },
      "additionalProperties": true
    },
    "engine": {
      "type": "object",
      "required": ["starts", "summary"],
      "properties": {
        "starts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/start"}},
        "summary": {
          "type": "object",
          "required": ["independent_starts", "startup_to_ready_s", "cold_ttft_s", "warm_prefix_ttft_s", "throughput", "request_failures"],
          "properties": {
            "independent_starts": {"type": "integer", "minimum": 3},
            "startup_to_ready_s": {"$ref": "#/$defs/distribution"},
            "cold_ttft_s": {"$ref": "#/$defs/distribution"},
            "warm_prefix_ttft_s": {"$ref": "#/$defs/distribution"},
            "request_failures": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["id", "family", "size_b", "quant", "artifacts", "engines", "comparison"],
      "properties": {
        "id": {"type": "string"},
        "family": {"const": "gemma-4"},
        "size_b": {"enum": [12, 31]},
        "quant": {"enum": ["Q4_0-QAT", "Q8_0", "NVFP4"]},
        "artifacts": {
          "type": "object",
          "required": ["fucina", "vllm"],
          "properties": {
            "fucina": {
              "type": "object",
              "required": ["path", "fingerprint"],
              "properties": {"path": {"type": "string"}, "fingerprint": {"$ref": "#/$defs/fingerprint"}}
            },
            "vllm": {
              "type": "object",
              "required": ["path", "fingerprint"],
              "properties": {"path": {"type": "string"}, "fingerprint": {"$ref": "#/$defs/fingerprint"}}
            }
          },
          "additionalProperties": false
        },
        "engines": {
          "type": "object",
          "required": ["fucina", "vllm"],
          "properties": {"fucina": {"$ref": "#/$defs/engine"}, "vllm": {"$ref": "#/$defs/engine"}},
          "additionalProperties": false
        },
        "comparison": {"type": "object"},
        "oracle": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    }
  }
}
